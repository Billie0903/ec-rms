# Copy this file to server/.env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000
# Where the React app runs (used for CORS in development and for activation links)
CLIENT_URL=http://localhost:5173

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=ec_rms_user
DB_PASSWORD=change-me
DB_NAME=ec_rms

# --- Auth ---
# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
INVITE_TTL_HOURS=72

# --- Email for activation links (optional in development: links are printed to the console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EC-RMS <no-reply@example.com>"

# --- AI weekly summary (optional, week 3) ---
ANTHROPIC_API_KEY=
